init 800 600
create rect bg 0 0 800 600 #ffffff
create text title 20 40 "My Diagram"
create circle c1 100 100 20 red
create rect box 200 80 60 60 #3366ff
group markers c1 box
tree
move c1 30 0
undo
redo
set title text "My Diagram v2"
undo
# Expected error: ancestor and descendant selected together.
group bad c1 markers
delete box
undo
save output/demo.svg
# Expected error: undo is disabled after saving.
undo
read fixtures/other.svg
tree
